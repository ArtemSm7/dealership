# Публичный шаблон переменных окружения.
# ВНИМАНИЕ: Не указывайте здесь реальные пароли и ключи! 
# Создайте копию этого файла с именем .env для локальной разработки.

# Секретный ключ Django
DJANGO_SECRET_KEY=replace-with-a-strong-random-value

# Режим отладки (True для локальной разработки, False для продакшена)
DJANGO_DEBUG=False

# Разрешённые хосты (домены), через запятую
DJANGO_ALLOWED_HOSTS=your-app.onrender.com

# Доверенные источники для проверки CSRF-токенов (с протоколом)
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com

# Строка подключения к базе данных.
# Если закомментировано или пусто, Django будет использовать локальную SQLite.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME